{
  "name": "@adonisjs/queue",
  "description": "Queue system for AdonisJS powered by @boringnode/queue",
  "version": "0.6.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build"
  ],
  "exports": {
    ".": "./build/index.js",
    "./otel": "./build/src/otel.js",
    "./queue_provider": "./build/providers/queue_provider.js",
    "./commands/*": "./build/commands/*.js",
    "./commands": "./build/commands/main.js",
    "./services/main": "./build/services/queue.js",
    "./types": "./build/src/types/main.js"
  },
  "scripts": {
    "build": "npm run compile",
    "clean": "del-cli build",
    "compile": "npm run clean && tsc",
    "copy:templates": "cpy \"stubs/**/*.stub\" build/stubs",
    "index:commands": "adonis-kit index build/commands",
    "format": "prettier --write .",
    "lint": "eslint .",
    "postcompile": "npm run copy:templates && npm run index:commands",
    "prepublishOnly": "npm run build",
    "quick:test": "node --enable-source-maps --import=@poppinss/ts-exec bin/test.ts",
    "test": "c8 npm run quick:test",
    "release": "release-it",
    "typecheck": "tsc --noEmit",
    "version": "npm run build"
  },
  "dependencies": {
    "@boringnode/queue": "^0.6.0"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/core": "^7.3.4",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/redis": "^10.0.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "better-sqlite3": "^13.0.3",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/node": "~24.11.2",
    "c8": "^11.0.0",
    "cpy-cli": "^7.0.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "kysely": "^0.29.3",
    "prettier": "^3.9.1",
    "release-it": "^20.2.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@adonisjs/redis": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "kysely": "^0.29.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/lucid": {
      "optional": true
    },
    "@adonisjs/redis": {
      "optional": true
    },
    "kysely": {
      "optional": true
    }
  },
  "overrides": {
    "c8": {
      "yargs": "^18.0.0"
    }
  },
  "author": "Romain Lanz <romain.lanz@pm.me>",
  "license": "MIT",
  "keywords": [
    "queue",
    "jobs",
    "background-jobs",
    "adonisjs",
    "adonis"
  ],
  "homepage": "https://github.com/adonisjs/queue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/queue.git"
  },
  "bugs": {
    "url": "https://github.com/adonisjs/queue/issues"
  },
  "prettier": "@adonisjs/prettier-config",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  }
}
